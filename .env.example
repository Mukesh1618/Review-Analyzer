# ==============================================================
#  ReviewMind AI — Backend Environment Variables
#  Copy this file to `.env` and fill in your values:
#       cp .env.example .env
#
#  ⚠️  Never commit your real `.env` file to version control.
# ==============================================================


# --------------------------------------------------------------
#  GROK MODEL SETTINGS (Azure AI Foundry / OpenAI-Compatible Endpoint)
#  The LLM powering all AI agents (grok-4-1-fast-reasoning via Azure Foundry).
# --------------------------------------------------------------
GROK_API_KEY=your_grok_api_key_here
GROK_API_BASE=https://reviewmind-resource.openai.azure.com
GROK_MODEL_NAME=gpt-5.6-luna


# --------------------------------------------------------------
#  BACKEND SERVER  (Optional — defaults shown)
#  Adjust if you need to run on a different host/port.
# --------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000


# --------------------------------------------------------------
#  LANGCHAIN / LANGSMITH TRACING  (Optional)
#  Enable this only if you want to trace LangChain calls in
#  LangSmith. Leave commented out to disable tracing.
#  Sign up at: https://smith.langchain.com/
# --------------------------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=ReviewMind
